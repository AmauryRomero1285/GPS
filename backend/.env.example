# Server
PORT=4000
NODE_ENV=development
APP_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173

# PostgreSQL (users & devices)
DB_USER=locfar_user
DB_HOST=127.0.0.1
DB_NAME=locfar_db
DB_PASSWORD=locfar12
DB_PORT=5432

# Auth
JWT_SECRET=change_this_secret
JWT_EXPIRES_IN=8h

# Refresh tokens (issued at login, used to renew an expired access token)
REFRESH_TOKEN_SECRET=change_this_refresh_secret
REFRESH_TOKEN_EXPIRES_IN=30d

# Device tokens (issued once at device registration, verified by signature only)
DEVICE_JWT_SECRET=change_this_device_secret
DEVICE_JWT_EXPIRES_IN=365d

# Token TTLs (hours) for one-time email links
EMAIL_VERIFICATION_EXPIRES_HOURS=24
SHARE_INVITE_EXPIRES_HOURS=72

# SMTP (verification emails, device-share invitations)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=locfarsupport1@gmail.com
SMTP_PASSWORD=qisrdiocravymzlj
SMTP_FROM="GPS Tracker <no-reply@gps-tracker.local>"

# MongoDB (telemetry)
MONGO_URI=mongodb://localhost:27017/gps_telemetry
